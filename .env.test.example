# ============================================================
# Premier CRM — Playwright E2E bot suite environment
# Copy this file to .env.test and fill in LOCAL/DEV/TEST credentials only.
# Never commit .env.test — it is gitignored.
# Never point BASE_URL at a production deployment.
# ============================================================

# Where the app under test is running. Start it yourself first: `pnpm dev`.
# The bot suite does not start the server for you — this keeps you in control
# of which environment (local / dev / staging) you're pointing at.
BASE_URL=http://localhost:3000

# ── Admin/owner account (used by auth, customers, invoices, permissions bots) ──
# Must be a real login in whatever Supabase project BASE_URL points to.
# Use a dedicated test org / seeded dev data — never a real customer's data.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# ── Customer account #1 (used by permissions/data-isolation bots) ──────────────
TEST_CUSTOMER_EMAIL=
TEST_CUSTOMER_PASSWORD=

# ── Customer account #2 (used to prove account #1 cannot see account #2's data) ─
TEST_CUSTOMER_2_EMAIL=
TEST_CUSTOMER_2_PASSWORD=

# ── Dedicated employee account (employee-invite-bot) ────────────────────────────
# A test-only account, never Brandon's (or anyone's) real email/credentials.
# Must be `delivered+<label>@resend.dev` — Resend's own reserved test address,
# guaranteed to accept delivery regardless of domain-verification state.
# @example.com/@example.invalid do NOT work here: Resend hard-rejects sending
# confirmation emails to those domains ("550 Invalid `to` field..."), and this
# account goes through a REAL Supabase Auth signUp() + email confirmation,
# unlike the other TEST_* accounts which never need a real email delivered.
# See utils/cleanup.ts's isTestOnlyEmail() — the bot's own reset step
# (deleteTestAuthUserByEmail) will refuse to clean up anything else.
TEST_EMPLOYEE_EMAIL=delivered+e2e-employee-bot@resend.dev
TEST_EMPLOYEE_PASSWORD=
TEST_EMPLOYEE_NAME=E2E Test Employee

# ── Optional: service-role cleanup for customer-crud-bot ───────────────────────
# Without these, customer-crud-bot's create/search/detail tests still run —
# they just leave the E2E_TEST_-prefixed test customer in place afterward
# (harmless, but see tests/e2e/README.md for how to remove it by hand).
#
# Same Supabase project BASE_URL/TEST_ADMIN_* point to. NEXT_PUBLIC_SUPABASE_URL
# is what this repo already uses elsewhere (packages/db/client.ts); SUPABASE_URL
# is accepted as a fallback. Get SUPABASE_SERVICE_ROLE_KEY from the same place
# apps/web/.env.local does — never a different (e.g. production) project's key.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cleanup refuses to run unless the Supabase URL above looks local
# (127.0.0.1/localhost, i.e. `supabase start`). Premier CRM does not currently
# have a confirmed separate dev/staging Supabase project, so a hosted URL is
# treated as "assume this is production" by default. Only set this to `true`
# if you are certain the project above is a dedicated dev/test project — never
# set it against a project that holds real customer data.
E2E_ALLOW_REMOTE_SUPABASE_CLEANUP=
