{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"C:/dev/Premier-CRM/.claude/hooks/pre-push-ancestry-check.sh\"",
            "if": "Bash(git push*)",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Checking branch ancestry against origin/main..."
          }
        ]
      }
    ]
  }
}
