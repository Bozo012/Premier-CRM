# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite database file path (relative to apps/autobay/)
DATABASE_URL="file:./prisma/dev.db"

# ─── LM Studio (Local AI) ──────────────────────────────────────────────────────
# Default: http://localhost:1234/v1 (LM Studio default port)
# Change if you're running LM Studio on a different port or machine.
LM_STUDIO_BASE_URL="http://localhost:1234/v1"

# LM Studio doesn't validate API keys, but the SDK requires a value.
LM_STUDIO_API_KEY="lm-studio"

# The model name must match what's loaded in LM Studio.
# Open LM Studio → look at the model name shown at the top.
# For vision analysis you need a multimodal model, e.g.:
#   - llava-v1.6-mistral-7b
#   - llama-3.2-11b-vision-instruct
#   - minicpm-v-2_6
# Text-only models will fail to analyze photos.
LM_STUDIO_MODEL="local-model"

# ─── eBay (currently mock-only) ────────────────────────────────────────────────
# TODO: Obtain credentials at https://developer.ebay.com (free account)
# EBAY_CLIENT_ID=""
# EBAY_CLIENT_SECRET=""
# EBAY_OAUTH_TOKEN=""
# EBAY_SANDBOX_MODE="true"
