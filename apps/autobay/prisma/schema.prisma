generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Listing {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Lifecycle: draft → generating → reviewing → ready → published_mock
  status String @default("draft")

  // JSON array of relative URLs like ["/uploads/abc123/photo-1.jpg"]
  photos String @default("[]")

  // Raw AI JSON response for debugging
  aiRaw String?

  // AI-generated fields (all editable by user)
  title          String?
  shortTitle     String?
  categoryGuess  String?
  condition      String?
  description    String?
  itemSpecifics  String? // JSON object: { "Brand": "Nike", "Size": "uncertain" }
  visibleDefects String? // JSON array of strings
  cannotVerify   String? // JSON array of strings
  priceLow       Float?
  priceHigh      Float?
  priceReasoning String?
  shipping       String?
  confidence     Float?
  questions      String? // JSON array of strings
  keywords       String? // JSON array of strings

  // eBay mock output
  ebayListingId   String?
  ebayPublishedAt DateTime?
  ebayMockUrl     String?
}
