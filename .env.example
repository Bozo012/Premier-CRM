# ============================================================
# Forge — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is gitignored.
# ============================================================

# ── Supabase (required) ──────────────────────────────────────
# Project URL and anon key are public (safe to expose to browser).
# Service role key is secret — server-side only, never expose to client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Project ID used by pnpm db:types when connecting to cloud project.
# Find it in: Supabase Dashboard → Project Settings → General
SUPABASE_PROJECT_ID=

# ── AI — Anthropic (required) ────────────────────────────────
# Used for all Claude calls (Haiku classification, Sonnet reasoning, Opus synthesis).
# Get it at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── AI — OpenAI (required for embeddings) ────────────────────
# Used only for text-embedding-3-large to generate vault item embeddings.
# Get it at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Transcription — Deepgram (required for capture pipeline) ─
# Used to transcribe audio recordings. Nova-3 model with diarization.
# Get it at: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# ── SMS / Voice — Twilio (required for communications) ───────
# Powers inbound/outbound SMS and future voice features.
# Get credentials at: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number in E.164 format, e.g. +18595551234
TWILIO_PHONE_NUMBER=

# ── Transactional Email — Resend (required for email) ────────
# Powers customer-facing emails: quote delivery, receipts, notifications.
# Get it at: https://resend.com/api-keys
RESEND_API_KEY=
# The "from" address for outgoing emails (must be a verified domain in Resend)
RESEND_FROM_EMAIL=

# ── Payments — Stripe (required for invoicing) ───────────────
# Secret key for server-side Stripe API calls.
# Webhook secret for verifying Stripe webhook payloads.
# Get credentials at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Maps — Google Maps Platform (required for geocoding + route planning) ──
# Used for property geocoding (Geocoding API v4), the live map (Maps
# JavaScript API), and route distance/duration (Routes API — Compute
# Routes). The legacy Directions API (maps/api/directions/json) and legacy
# Geocoding API v3 (maps/api/geocode/json) are NOT used by this codebase —
# see docs/implementation/maps-routes-modernization.md for the full
# architecture and provisioning checklist.
# Enable: Maps JavaScript API, Geocoding API, Routes API
# Get it at: https://console.cloud.google.com/apis/credentials
#
# ── Testing/prototyping: Google Maps Demo Key ──────────────────
# https://developers.google.com/maps/demo-key — no billing account
# required, supports Maps JavaScript API + Geocoding API v4 + Routes API
# (Compute Routes), which is exactly the set this app uses. Google's Demo
# Key documentation does not describe a separate browser/server variant, so
# the SAME demo key value may be used for both variables below during
# testing. THIS IS TESTING-ONLY, NOT A PRODUCTION CREDENTIAL — it is
# unrestricted, rate-limited, and explicitly not meant for real traffic.
# Never treat a working demo-key deployment as production sign-off.
#
# ── Production: two separate keys, two separate restriction models ────
# GOOGLE_MAPS_API_KEY — server-only. Called only from server code (server
# components/actions) for Geocoding API v4 + Routes API. Never sent to the
# browser. Restrict to: the specific APIs actually used (Geocoding API,
# Routes API) and, if your hosting platform provides a stable outbound IP
# mechanism, an IP address restriction — do not invent one where none
# exists (e.g. standard Vercel serverless functions have no fixed egress
# IP by default).
GOOGLE_MAPS_API_KEY=
#
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY — intentionally browser-visible (the Maps
# JavaScript API requires this by Google's own design; there is no way to
# keep a Maps JS key secret). Restrict to: HTTP referrers (your app's real
# production domain(s)), APIs: Maps JavaScript API only. Do NOT reuse the
# server key here and do NOT grant this key Geocoding/Routes access.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Material Pricing — BigBox API (Phase 3) ──────────────────
# Used to fetch live Home Depot / Lowe's / Menards SKU prices.
# Leave blank until Phase 3 pricing engine work begins.
BIGBOX_API_KEY=

# ── Fuel Pricing — EIA API (Phase 3) ─────────────────────────
# Used for weekly fuel price feed to keep mileage cost estimates accurate.
# Free key at: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# ── App ──────────────────────────────────────────────────────
# Public URL of the app — used for magic link callbacks and absolute URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public marketing site URL — unauthenticated customer portal entry point.
NEXT_PUBLIC_MARKETING_SITE_URL=https://www.ppmnky.com
# Optional comma-separated marketing preview origins allowed to POST portal handoff forms.
PORTAL_HANDOFF_ALLOWED_ORIGINS=

# ── Local AI (optional, dev only) ────────────────────────────
# Set these to use LM Studio / Qwen instead of Anthropic during development.
# Production always uses Anthropic regardless of these values.
# LOCAL_LLM_URL=http://localhost:1234/v1
# AI_PROVIDER=local
